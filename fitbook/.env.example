SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=FitBook <no-reply@fitbook.app>
# Cloudinary (optional, for image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# ===== Client =====
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
